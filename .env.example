# Copia este archivo a `.env` y completa los valores reales (nunca commitear `.env`).
# La base de datos no corre en Docker: se usa el PostgreSQL del host (contenedor local-postgres).
# Crear antes el rol y la base `career_analyzer` en ese servidor.

DATABASE_URL=postgresql://career_analyzer:<password>@host.docker.internal:5432/career_analyzer?schema=public
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:4200

BACKEND_PORT=3000
FRONTEND_PORT=4200
NGINX_PORT=8080
