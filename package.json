{
  "name": "career-analyzer",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present",
    "start:backend": "npm run start:dev -w career-analyzer-backend",
    "start:frontend": "npm run start -w career-analyzer-frontend",
    "docker:up": "node scripts/docker-up.js",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:build": "docker compose -f docker-compose.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  }
}